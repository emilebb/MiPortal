# MiPortal · Variables de entorno (copiar a .env para desarrollo local)
# El bloque público se publica en supabase-config.js. El bloque servidor NO.
# Configurar las mismas variables en Vercel → Settings → Environment Variables.

# ── Bloque público (llega al navegador) ─────────────────────────────────────
SUPABASE_URL=https://TU-PROYECTO.supabase.co
SUPABASE_PUBLISHABLE_KEY=eyJhbGciOi...tu-publishable-key... (anon public key)

# ── Formulario de contacto (solo servidor) ──────────────────────────────────
# POST /api/contact deriva el mensaje al workflow de n8n.
# Resend se utiliza en el newsletter; verificar entrega y protección de n8n aparte.
# RESEND_API_KEY: clave de envío de Resend (re_...).
RESEND_API_KEY=
# Remitente: dirección simple de un dominio verificado en Resend,
# sin nombre ni <corchetes>. Ejemplo: "contacto@tudominio.com"
RESEND_FROM_EMAIL=
# Destinatario confirmado; el navegador no puede elegirlo.
CONTACT_TO_EMAIL=emile.123455@gmail.com

# ── Newsletter (solo servidor) ──────────────────────────────────────────────
# POST /api/newsletter sí usa Supabase para el alta y el antiabuso.
SUPABASE_SECRET_KEY=
NEWSLETTER_HASH_SECRET=

# ── Newsletter · novedades automáticas (solo servidor) ──────────────────────
# Al publicar contenido, api/newsletter-send.js envía un correo a los
# suscriptores confirmados.
# NEWSLETTER_SEND_ENABLED: en PRODUCCIÓN poner "true". En desarrollo déjalo en
# "false" (o fuera): NUNCA se escribirá a suscriptores reales y, si existe
# NEWSLETTER_TEST_EMAIL, el correo de la novedad se enviará solo a esa
# dirección de prueba.
NEWSLETTER_SEND_ENABLED=false
# Destinatario único para probar el asunto/HTML del correo en desarrollo
# (ej: tu propio correo de Gmail). Vacío = no se envía nada en modo prueba.
NEWSLETTER_TEST_EMAIL=

# ── MiPortal Pro · Mercado Pago (solo servidor) ─────────────────────────────
# POST /api/mp-preference crea el Checkout Pro con external_reference=user_id.
# MERCADOPAGO_ACCESS_TOKEN: token de producción de tu app en
# Mercado Pago → Tu negocio → Configuración → Credenciales (TEST puede usarse
# para probar con fondos de prueba).
MERCADOPAGO_ACCESS_TOKEN=
# El entorno del pago debe coincidir con este valor: test o production.
MERCADOPAGO_MODE=test
# Firma obligatoria. Nunca desactivar para probar el webhook.
MERCADOPAGO_WEBHOOK_SECRET=
# URL del webhook a configurar en el panel de MP:
#   https://www.miportal.me/api/webhook-mercadopago
# URL de éxito a configurar en el Checkout Pro / Redirect:
#   https://www.miportal.me/gracias-pro.html

# Asistente: credencial compartida con Header Auth del workflow n8n (mínimo 32 caracteres).
# La misma credencial deriva hashes de IP/sesión; no llega al navegador.
N8N_ASSISTANT_WEBHOOK_SECRET=
# Requiere SUPABASE_SECRET_KEY y la migración assistant_account_quota.
