{
  "name": "miportal",
  "private": true,
  "version": "1.0.0",
  "description": "Sitio estático MiPortal + backend Supabase para el CRUD de Recursos",
  "scripts": {
    "build": "node scripts/generate-config.mjs && node scripts/build-static.mjs",
    "test:build": "node --test scripts/build-static.test.mjs",
    "test:search": "node --test scripts/global-search-utils.test.mjs",
    "test:assistant": "node --test scripts/miportal-assistant.test.mjs scripts/assistant-api.test.cjs",
    "dev": "node scripts/generate-config.mjs",
    "test:contact": "node --test scripts/contact.test.cjs scripts/contact-browser.test.mjs",
    "test:newsletter": "node --test scripts/newsletter.test.cjs scripts/newsletter-send.test.cjs scripts/admin-publish.test.cjs",
    "test:admin": "node --test scripts/admin-browser.test.mjs",
    "test:mercadopago": "node --test scripts/mercadopago.test.cjs",
    "test": "node scripts/run-tests.mjs",
    "test:unit": "node scripts/run-tests.mjs unit",
    "test:browser": "node scripts/run-tests.mjs browser",
    "test:db": "node --test scripts/rls.test.mjs scripts/subscriptions.test.mjs"
  },
  "license": "UNLICENSED",
  "dependencies": {
    "@supabase/supabase-js": "2.116.0"
  },
  "devDependencies": {
    "@electric-sql/pglite": "0.5.10"
  }
}
